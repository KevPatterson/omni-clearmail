# Omni-CleanerMail - configuracion por entorno (.env)
# Se lee solo si existe (python-dotenv opcional). Las variables reales del
# sistema tienen prioridad. Con LOOK_* se marca entorno de produccion.

# ---- enlaces de red -------------------------------------------------------
LOOK_BIND=127.0.0.1
LOOK_PORT=8000
OMNI_DATA_DIR=

# ---- SMTP salida (reportes por buzón, avisos de licencia) -----------------
LOOK_SMTP_HOST=
LOOK_SMTP_PORT=587
LOOK_SMTP_FROM=licencias@omni.group
LOOK_SMTP_USER=
LOOK_SMTP_PASSWORD=
LOOK_NOTIFY_EMAIL=

# ---- seguridad ------------------------------------------------------------
LOOK_HMAC_SECRET=genera_una_clave_aleatoria_larga_aqui
LOOK_API_KEY_TTL_DAYS=365

# ---- remitentes internos (buzones de la organizacion) ---------------------
# Enumera tu dominio separado por comas: micol.com,corp.demo
OMNI_INTERNAL_DOMAINS=micol.com